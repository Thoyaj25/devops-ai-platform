generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  passwordHash String?
  role         UserRole   @default(DEVELOPER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  auditLogs    AuditLog[]
  projects     Project[]
}

model Cluster {
  id        String    @id @default(cuid())
  name      String
  provider  String?
  region    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  projects  Project[]
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  ownerId     String
  clusterId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id])
  cluster      Cluster?      @relation(fields: [clusterId], references: [id])
  deployments  Deployment[]
  environments Environment[]
  pipelines    Pipeline[]
}

model Environment {
  id        String          @id @default(cuid())
  name      String
  type      EnvironmentType
  projectId String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployments Deployment[]
}

model Pipeline {
  id            String   @id @default(cuid())
  name          String
  provider      String?
  repository    String?
  projectId     String
  branch        String?  @default("main")
  buildCommand  String?
  deployCommand String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployments Deployment[]
}

model Deployment {
  id            String           @id @default(cuid())
  version       String?
  status        DeploymentStatus @default(PENDING)
  projectId     String
  environmentId String
  pipelineId    String
  logs          String?
  image         String?
  containerId   String?
  containerUrl  String?
  hostPort      Int?
  isHealthy     Boolean          @default(false)
  errorMessage  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment    Environment     @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  pipeline       Pipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  jobs           DeploymentJob[]
  deploymentLogs DeploymentLog[]

  @@index([projectId])
  @@index([environmentId])
  @@index([pipelineId])
  @@index([status])
  @@index([createdAt])
}

model DeploymentJob {
  id           String    @id @default(cuid())
  deploymentId String
  status       JobStatus @default(PENDING)

  attempts     Int       @default(0)
  error        String?

  nextRetryAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  cancelRequestedAt DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
  @@index([status])
  @@index([createdAt])
}

model DeploymentLog {
  id           String   @id @default(cuid())
  deploymentId String
  stage        String?
  message      String
  createdAt    DateTime @default(now())

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
  @@index([createdAt])
}

model WorkerHeartbeat {
  id        String   @id @default(cuid())
  workerId  String   @unique
  lastSeen  DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  resource  String
  userId    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum UserRole {
  ADMIN
  DEVOPS_ENGINEER
  DEVELOPER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum DeploymentStatus {
  PENDING

  CHECKING_OUT
  BUILDING
  DEPLOYING
  HEALTH_CHECKING

  SUCCESS
  FAILED

  ROLLING_BACK
  ROLLED_BACK

  SUPERSEDED

  CANCELLED
  STOPPED
}

enum JobStatus {
  PENDING
  RUNNING

  CANCEL_REQUESTED
  CANCELLED

  COMPLETED
  FAILED
}
